<?xml version="1.0"?>
<robot name="diuniu">

  <!-- 定义全新材质：工业橙色(带 40% 透明度，方便看内部结构) -->
  <material name="orange"><color rgba="1.0 0.5 0.0 0.6"/></material>
  <material name="black"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="blue"><color rgba="0.0 0.5 1.0 1.0"/></material>
  <material name="green"><color rgba="0.0 0.8 0.2 1.0"/></material>
  <material name="red"><color rgba="0.8 0.0 0.0 1.0"/></material>

  <!-- 1. 核心原点：base_link (位于两后轮中心) -->
  <link name="base_link">
    <visual>
      <!-- 车身几何中心位于 0.65m，总长 1.90m (前轮向前 30cm，后轮向后 30cm) -->
      <origin xyz="0.65 0 0.18" rpy="0 0 0"/>
      <geometry>
        <!-- 真实尺寸：长 1.90m, 宽 0.7m, 高 0.2m -->
        <box size="1.90 0.7 0.2"/>
      </geometry>
      <!-- 使用半透明橙色 -->
      <material name="orange"/>
    </visual>
  </link>

  <!-- 2. 前驱动/转向轮 -->
  <link name="front_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.085" length="0.08"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="front_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_wheel"/>
    <!-- 前轮位于后轮正前方 1.3m 处 -->
    <origin xyz="1.3 0 0.085" rpy="0 0 0"/>
  </joint>

  <!-- 3. 左后轮 -->
  <link name="rear_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.085" length="0.05"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="rear_left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <!-- 轮距 0.53m 的一半是 0.265m -->
    <origin xyz="0 0.265 0.085" rpy="0 0 0"/>
  </joint>

  <!-- 4. 右后轮 -->
  <link name="rear_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.085" length="0.05"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="rear_right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="0 -0.265 0.085" rpy="0 0 0"/>
  </joint>

  <!-- 5. 传感器：IMU 安装位置（内置于 Livox Mid360 倒装雷达内部） -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.05 0.05 0.02"/></geometry>
      <material name="blue"/>
    </visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="laser_link"/>
    <child link="imu_link"/>
    <!-- IMU 位于 Livox 雷达壳体内部，直接绑定在 laser_link (160cm 倒装) -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- 5b. 传感器：底盘主控板载 BNO085 IMU（/imu/data 数据来源，EKF 航向融合用） -->
  <!-- ⚠️ 与 imu_link (雷达内置 IMU) 是两个物理器件，勿共用 frame：
       BNO085 装在底盘主控板上，近似与 base_link 同向；实测存在 ~10° 安装倾斜/校准残差，
       但 EKF 为 two_d_mode 仅融合 yaw，常值航向偏差由 AMCL 的 map→odom 吸收 -->
  <link name="base_imu_link">
    <visual>
      <geometry><box size="0.05 0.05 0.02"/></geometry>
      <material name="green"/>
    </visual>
  </link>
  <joint name="base_imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_imu_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

  <!-- 6. 传感器：激光雷达安装位置 -->
  <link name="laser_link">
    <visual>
      <!-- 给雷达加一个小红圆柱做外观 -->
      <geometry><cylinder radius="0.035" length="0.05"/></geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <!-- 雷达真实物理安装：高度为 160cm (1.60m)，倒装 (roll=180° / 3.14159265 rad) -->
    <origin xyz="1.215 0 1.60" rpy="3.14159265 0 0"/> 
  </joint>

</robot>
