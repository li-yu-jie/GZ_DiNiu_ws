<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>diuniu_apriltag</name>
  <version>0.0.0</version>
  <description>DiuNiu 视觉感知包：Orbbec RGB 相机驱动 + 图像去畸变 + AprilTag 识别</description>
  <maintainer email="Liyujie@qq.com">y</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>image_proc</exec_depend>
  <exec_depend>apriltag_ros</exec_depend>
  <!-- apriltag.launch.py 引用：机器人模型（camera TF）与可视化 -->
  <exec_depend>diuniu_description</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
